# Copier en ".env" pour changer l'API utilisée par l'app (le .env n'est pas commité).
# Sans .env, l'app utilise l'API de production : https://garden-track-api.onrender.com

# API de production (Render)
EXPO_PUBLIC_API_URL=https://garden-track-api.onrender.com

# API lancée sur ton PC (remplacer par l'adresse IPv4 du PC, donnée par "ipconfig") :
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
