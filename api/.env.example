# Copier ce fichier en ".env" et remplir les valeurs (le .env n'est jamais commité)

# Port du serveur
PORT=3000

# URI de connexion MongoDB Atlas (Database > Connect > Drivers)
# Ajouter le nom de la base après le "/" : ...mongodb.net/gardentrack
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/gardentrack

# Optionnel : si "npm run seed" ou "npm run dev" échoue avec "querySrv ECONNREFUSED",
# décommenter la ligne suivante pour utiliser des serveurs DNS publics
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Broker MQTT (EMQX) : réception des photos du piège photo.
# Sans MQTT_URL, l'API démarre quand même mais ne reçoit aucune photo.
MQTT_URL=mqtts://v0a1cd16.ala.eu-central-1.emqxsl.com:8883
MQTT_USERNAME=serveur
MQTT_PASSWORD=
# Valeurs par défaut (facultatives) :
# MQTT_TOPIC=trackgarden/captures
# MQTT_CLIENT_ID=trackgarden-api
