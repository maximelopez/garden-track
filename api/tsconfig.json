{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Node exécute le TypeScript directement : imports en ".ts"
    "allowImportingTsExtensions": true,
    // Uniquement de la syntaxe que Node sait "effacer" (pas d'enum, pas de namespace…)
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
